---
const clients = [
  '3M',
  'Profertil',
  'MS Representaciones',
  'Neuralsoft',
  'Quimargen',
  'Schoss',
  'SIE',
  'TESMA',
  'TODORIEGO',
  'Polytech S.A.',
  'Actiontravel',
  'Centro Medico Deragopyan',
  'Keady',
  'Aliar Gestion Alimentaria',
  'Multiradio',
];
---
<section class="py-20 bg-white">
  <div class="container mx-auto px-4">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-800">Nuestros Clientes</h2>
    </div>
    <div class="flex flex-wrap justify-center items-center gap-8">
      {clients.map(client => (
        <div class="grayscale hover:grayscale-0 transition-all">
          <p class="text-gray-500 font-semibold text-lg">{client}</p>
        </div>
      ))}
    </div>
  </div>
</section>